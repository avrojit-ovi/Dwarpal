<UserControl x:Class="Dwarpal.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
        <StackPanel>
            <StackPanel>
                <TextBlock Text="Profiles" Style="{StaticResource HeroText}" FontSize="24" />
                <TextBlock Text="Ek somoy e ekta profile active — setai decide kore kon app lock hobe."
                           Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,14,0,0" FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Active profile summary -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource OverlineText}" FontSize="9.5" />
                        <TextBlock Text="{Binding ActiveProfileText}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GoldSoftBrush}"
                                   Margin="0,6,0,0" />
                        <TextBlock Text="{Binding ActiveProfileSummary}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11.5"
                                   Margin="0,4,0,0" />
                    </StackPanel>

                    <Button Grid.Column="1"
                            Content="Use all apps"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,8"
                            FontSize="12"
                            VerticalAlignment="Center"
                            Visibility="{Binding HasActiveProfile, Converter={StaticResource BoolToVisibility}}"
                            Click="OnAllAppsClick" />
                </Grid>
            </Border>

            <!-- Create -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="New profile" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Text="Naam diye profile banao, tarpor kon app gulo ei profile e protect hobe set koro."
                               Style="{StaticResource MutedText}"
                               FontSize="11.5"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding NewProfileName, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="OnNameKeyDown"
                                 ToolTip="Profile name" />
                        <Button Grid.Column="1"
                                Content="Create profile"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"
                                Click="OnCreateClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- List -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasProfiles, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="PROFILE" Style="{StaticResource OverlineText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="ACTIONS" Style="{StaticResource OverlineText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,10,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Profiles}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                                <Border Background="{StaticResource GoldTintBrush}"
                                                        BorderBrush="{StaticResource GoldBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="10"
                                                        Padding="8,1"
                                                        Margin="8,0,0,0"
                                                        VerticalAlignment="Center"
                                                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVisibility}}">
                                                    <TextBlock Text="ACTIVE" Style="{StaticResource OverlineText}" FontSize="8" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding AppCountText}"
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="10.5"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="Choose apps"
                                                    Style="{StaticResource LinkButton}"
                                                    FontSize="11.5"
                                                    Click="OnAppsClick" />
                                            <Button Content="Activate"
                                                    Style="{StaticResource LinkButton}"
                                                    FontSize="11.5"
                                                    Margin="10,0,0,0"
                                                    Visibility="{Binding CanActivate, Converter={StaticResource BoolToVisibility}}"
                                                    Click="OnActivateClick" />
                                        </StackPanel>

                                        <Button Grid.Column="2"
                                                Content="Delete"
                                                Style="{StaticResource LinkButton}"
                                                Foreground="{StaticResource MutedBrush}"
                                                FontSize="11.5"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Visibility="{Binding CanDelete, Converter={StaticResource BoolToVisibility}}"
                                                Click="OnDeleteClick" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasNoProfiles, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,8">
                    <TextBlock Text="No profiles yet" Style="{StaticResource TitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="Upore naam diye ekta profile banao — jemon 'Work' ba 'Gaming'."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
