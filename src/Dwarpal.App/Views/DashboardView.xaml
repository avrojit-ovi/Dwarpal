<UserControl x:Class="Dwarpal.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
        <StackPanel>
            <TextBlock Text="{Binding Greeting}" Style="{StaticResource HeroText}" FontSize="24" />
            <TextBlock Text="Dwarpal account ar protection er current state."
                       Style="{StaticResource MutedText}"
                       Margin="0,6,0,0" />

            <!-- Stats -->
            <Grid Margin="0,20,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,8,0">
                    <StackPanel>
                        <TextBlock Text="ACTIVE PROFILE" Style="{StaticResource OverlineText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding ActiveProfile}" Style="{StaticResource StatValue}" FontSize="24" />
                        <TextBlock Text="Active protection profile" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="4,0,4,0">
                    <StackPanel>
                        <TextBlock Text="PROTECTED APPS" Style="{StaticResource OverlineText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding ProtectedAppCount}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="{Binding ProtectedAppsSubtext}" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardBorder}" Margin="8,0,0,0">
                    <StackPanel>
                        <TextBlock Text="FAILED UNLOCKS TODAY" Style="{StaticResource OverlineText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="{Binding FailedUnlocksToday}" Style="{StaticResource StatValue}" />
                        <TextBlock Text="Bhul credential attempt" Style="{StaticResource MutedText}" FontSize="11" Margin="0,6,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Security status -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Security status" Style="{StaticResource TitleText}" FontSize="15" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="Unlock credential" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding CredentialLabel}" Style="{StaticResource StatusValue}" />
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,10" />

                    <Grid>
                        <TextBlock Text="Recovery key" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding RecoveryKeyStatus}" Style="{StaticResource StatusValue}" />
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,10" />

                    <Grid>
                        <TextBlock Text="Auto re-lock" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding AutoRelockLabel}" Style="{StaticResource StatusValue}" />
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,10" />

                    <Grid>
                        <TextBlock Text="Protection engine" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding ProtectionStatusText}">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource StatusValue}">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsProtectionActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Style="{StaticResource MutedText}"
                               Margin="0,14,0,0"
                               FontSize="11.5"
                               Text="Process start watch WMI diye hoy, protected app suspend kore lock screen dekhano hoy. Background/idle re-lock ar grace period Settings page theke control koro." />
                </StackPanel>
            </Border>

            <!-- Recent activity -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Recent activity" Style="{StaticResource TitleText}" FontSize="15" />
                        <TextBlock Text="Latest 6 events" Style="{StaticResource MutedText}" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="11" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding RecentActivity}" Margin="0,12,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0"
                                               Text="{Binding TimeText}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="11"
                                               FontFamily="{StaticResource MonoFont}"
                                               Width="46"
                                               VerticalAlignment="Center" />

                                    <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center" Margin="2,0,10,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource MutedText}" FontSize="11" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Visibility="{Binding IsActivityEmpty, Converter={StaticResource BoolToVisibility}}" Margin="0,14,0,4">
                        <TextBlock Text="Ekhono kono activity nei."
                                   Style="{StaticResource MutedText}"
                                   FontSize="11.5" />
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="Dwarpal · Windows 10/11 · Argon2id credential protection"
                       Style="{StaticResource MutedText}"
                       FontSize="10.5"
                       HorizontalAlignment="Center"
                       Margin="0,18,0,4" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
