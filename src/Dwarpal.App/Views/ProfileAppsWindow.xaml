<Window x:Class="Dwarpal.App.Views.ProfileAppsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Profile apps"
        Width="480" Height="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Opacity="0"
        Style="{StaticResource AppWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="4"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragAreaMouseDown">
                <TextBlock Text="PROFILE APPS" Style="{StaticResource OverlineText}" FontSize="10"
                           VerticalAlignment="Center" Margin="24,0,0,0" />
                <Button Style="{StaticResource TitleBarCloseButton}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Content="&#xE8BB;" ToolTip="Close" Click="OnCancelClick" />
            </Grid>

            <StackPanel Grid.Row="1" Margin="24,4,24,0">
                <TextBlock x:Name="ProfileNameText" Style="{StaticResource TitleText}" FontSize="17" />
                <TextBlock Text="Je app gulo ei profile e lock hobe bacho. Baki app gulo normal vabe cholbe."
                           Style="{StaticResource MutedText}"
                           FontSize="11"
                           Margin="0,5,0,0" />
            </StackPanel>

            <Grid Grid.Row="2" Margin="24,14,24,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl x:Name="AppsList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource InputBackgroundBrush}"
                                        BorderBrush="{StaticResource BorderSoftBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="12,9"
                                        Margin="0,0,0,7">
                                    <Grid>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ExecutablePath}"
                                                       Style="{StaticResource MutedText}"
                                                       FontSize="10"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <CheckBox Style="{StaticResource AppCheckBox}"
                                                  Content="Include"
                                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                  Checked="OnSelectionChanged"
                                                  Unchecked="OnSelectionChanged"
                                                  HorizontalAlignment="Right"
                                                  VerticalAlignment="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock x:Name="EmptyText"
                           Text="Protected Apps page e age kono app add koro."
                           Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Visibility="Collapsed" />
            </Grid>

            <Grid Grid.Row="3" Margin="24,16,24,22">
                <TextBlock x:Name="SelectionText"
                           Style="{StaticResource MutedText}"
                           FontSize="11"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Cancel"
                            Style="{StaticResource SecondaryButton}"
                            Padding="16,8"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="OnCancelClick" />
                    <Button Content="Save"
                            Style="{StaticResource PrimaryButton}"
                            Padding="20,9"
                            FontSize="12.5"
                            Click="OnSaveClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
