<Window x:Class="Dwarpal.App.Views.UnlockWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="clr-namespace:Dwarpal.App.Controls"
        mc:Ignorable="d"
        Title="Dwarpal"
        WindowStartupLocation="CenterScreen"
        Width="480" Height="690"
        Opacity="0"
        Style="{StaticResource AppWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="4"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragAreaMouseDown">
                <TextBlock Text="DWARPAL"
                           Style="{StaticResource OverlineText}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Button Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;"
                            ToolTip="Minimize"
                            Click="OnMinimizeClick" />
                    <Button Style="{StaticResource TitleBarCloseButton}"
                            Content="&#xE8BB;"
                            ToolTip="Close"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="34,0,34,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <Border Width="88" Height="88"
                            CornerRadius="24"
                            Background="{StaticResource GoldTintBrush}"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center"
                            Padding="8">
                        <Image Source="pack://application:,,,/Dwarpal;component/Assets/Branding/dwarpal-mark-512.png"
                               Stretch="Uniform"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>

                    <TextBlock Text="Welcome back"
                               Style="{StaticResource HeroText}"
                               FontSize="26"
                               HorizontalAlignment="Center"
                               Margin="0,18,0,0" />
                    <TextBlock Text="Unlock Dwarpal to continue"
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />

                    <controls:PinPad x:Name="PinPadControl"
                                     Margin="0,22,0,0"
                                     Visibility="{Binding IsPin, Converter={StaticResource BoolToVisibility}}"
                                     IsEnabled="{Binding CanAttempt}"
                                     Submitted="OnPinPadSubmitted"
                                     SecretChanged="OnSecretChanged" />

                    <StackPanel Visibility="{Binding IsPassword, Converter={StaticResource BoolToVisibility}}">
                        <PasswordBox x:Name="PasswordBoxInput"
                                     Style="{StaticResource AppPasswordBox}"
                                     FontSize="15"
                                     Margin="0,28,0,0"
                                     IsEnabled="{Binding CanAttempt}"
                                     KeyDown="OnPasswordKeyDown"
                                     ToolTip="Password" />
                        <Button Content="Unlock"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,12,0,0"
                                IsEnabled="{Binding CanAttempt}"
                                Click="OnUnlockPasswordClick" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource DangerText}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,14,0,0" />

                    <TextBlock Text="{Binding Lockout.Text}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource GoldSoftBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />

                    <TextBlock x:Name="InfoText"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"
                               Margin="0,4,0,0"
                               Text="" />

                    <Button Content="Forgot PIN or password?"
                            Style="{StaticResource LinkButton}"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0"
                            Click="OnForgotClick" />
                </StackPanel>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center">
                    <Rectangle Height="1" Width="80" Fill="{StaticResource HairlineBrush}" Margin="0,0,0,12" />
                    <TextBlock Text="Argon2id secured · Dwarpal"
                               Style="{StaticResource MutedText}"
                               FontSize="10.5"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
