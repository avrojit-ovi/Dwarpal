<UserControl x:Class="Dwarpal.App.Views.ActivityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="820">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
        <StackPanel>
            <Grid>
                <StackPanel>
                    <TextBlock Text="Activity log" Style="{StaticResource HeroText}" FontSize="24" />
                    <TextBlock Text="Unlock, lock, tamper ar settings — sob audit trail."
                               Style="{StaticResource MutedText}"
                               Margin="0,6,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Refresh"
                            Style="{StaticResource SecondaryButton}"
                            Padding="14,8"
                            FontSize="12"
                            Margin="0,0,8,0"
                            Click="OnRefreshClick" />
                    <Button Content="Export CSV"
                            Style="{StaticResource PrimaryButton}"
                            Padding="16,9"
                            FontSize="12.5"
                            Click="OnExportClick" />
                </StackPanel>
            </Grid>

            <Grid Margin="0,18,0,0">
                <TextBox x:Name="SearchBox"
                         Style="{StaticResource AppTextBox}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         KeyDown="OnSearchKeyDown"
                         ToolTip="App name, detail othoba event search koro" />
                <Button Content="Search"
                        Style="{StaticResource SecondaryButton}"
                        Padding="16,8"
                        FontSize="12"
                        HorizontalAlignment="Right"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Click="OnSearchClick" />
            </Grid>

            <TextBlock Text="{Binding StatusMessage}"
                       Margin="0,12,0,0"
                       FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Border Style="{StaticResource CardBorder}"
                    Margin="0,14,0,0"
                    Visibility="{Binding HasRows, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl ItemsSource="{Binding Rows}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="0,9">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TimeText}"
                                                   FontFamily="{StaticResource MonoFont}"
                                                   FontSize="12" />
                                        <TextBlock Text="{Binding DateText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="9.5" />
                                    </StackPanel>

                                    <Ellipse Grid.Column="1" Width="6" Height="6" VerticalAlignment="Center" Margin="4,0,12,0">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFailure}" Value="True">
                                                        <Setter Property="Fill" Value="{StaticResource DangerBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="12.5" />
                                        <TextBlock Text="{Binding Detail}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="10.5"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxWidth="460"
                                                   HorizontalAlignment="Left" />
                                    </StackPanel>

                                    <TextBlock Grid.Column="3"
                                               Text="{Binding AppName}"
                                               Style="{StaticResource MutedText}"
                                               FontSize="10.5"
                                               VerticalAlignment="Center"
                                               Margin="10,0,10,0"
                                               TextTrimming="CharacterEllipsis"
                                               MaxWidth="130" />

                                    <Button Grid.Column="4"
                                            Content="Selfie"
                                            Style="{StaticResource LinkButton}"
                                            FontSize="10.5"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding HasSelfie, Converter={StaticResource BoolToVisibility}}"
                                            Click="OnSelfieClick" />
                                </Grid>
                                <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,12">
                    <TextBlock Text="No matching activity" Style="{StaticResource TitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="Search clear koro othoba Refresh dao."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
