<UserControl x:Class="Dwarpal.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="820">

    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource SurfaceHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{StaticResource GoldTintBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SettingLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
        <StackPanel>
            <TextBlock Text="Settings" Style="{StaticResource HeroText}" FontSize="24" />
            <TextBlock Text="Re-lock behaviour, startup ar account summary."
                       Style="{StaticResource MutedText}"
                       Margin="0,6,0,0" />

            <!-- ============ Auto re-lock ============ -->
            <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0">
                <StackPanel>
                    <TextBlock Text="Auto re-lock" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Text="Protected app unlock korar por jodi app ta background e chole jay ba PC idle thake, tahole nirdisto somoy por abar lock screen ashbe. Suspend/resume engine ei setting sathe sathe follow kore."
                               Style="{StaticResource MutedText}"
                               FontSize="11.5"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Lock after app is inactive or in background" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="{Binding AutoRelockHint}"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xE738;"
                                    Style="{StaticResource StepButton}"
                                    FontFamily="{StaticResource IconFont}"
                                    ToolTip="Kom somoy"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Command="{Binding PreviousAutoRelockCommand}" />
                            <TextBlock Text="{Binding AutoRelockText}"
                                       Width="110"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldSoftBrush}" />
                            <Button Content="+"
                                    Style="{StaticResource StepButton}"
                                    ToolTip="Beshi somoy"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Command="{Binding NextAutoRelockCommand}" />
                        </StackPanel>
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,16" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="Grace period after unlock" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Unlock er por eto somoy auto re-lock trigger hobe na."
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="&#xE738;"
                                    Style="{StaticResource StepButton}"
                                    FontFamily="{StaticResource IconFont}"
                                    ToolTip="Kom grace"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Command="{Binding PreviousGraceCommand}" />
                            <TextBlock Text="{Binding GraceText}"
                                       Width="110"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="13.5"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource GoldSoftBrush}" />
                            <Button Content="+"
                                    Style="{StaticResource StepButton}"
                                    ToolTip="Beshi grace"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Command="{Binding NextGraceCommand}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}"
                               Margin="0,16,0,0"
                               FontSize="11.5">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                                <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>
            </Border>

            <!-- ============ Failed attempts ============ -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Failed attempts" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Text="5 ta bhul credential er por lockout shuru hoy. Prottek lockout e duration double hoy — 30s, 60s, 120s — max 15 minute. State database e thake, tai app restart korleo cooldown thake."
                               Style="{StaticResource MutedText}"
                               FontSize="11.5"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Capture intruder selfie on repeated failures" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="3rd bhul attempt o lockout e webcam theke ekta encrypted snapshot newa hoy."
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="SelfieCheckBox"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Enabled"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsNotBusy}"
                                  IsChecked="{Binding SelfieEnabled, Mode=OneWay}"
                                  Click="OnSelfieClick" />
                    </Grid>

                    <TextBlock Text="Camera na thakle ba permission block thakle selfie skip hoy — unlock flow kokhono atke na."
                               Style="{StaticResource MutedText}"
                               FontSize="10.5"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ Panic hotkey ============ -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Panic hotkey" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Text="Jekono somoy panic hotkey chaple sob running protected app sathe sathe lock hobe — schedule window ignore kore."
                               Style="{StaticResource MutedText}"
                               FontSize="11.5"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="Hotkey" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="Ctrl + Alt + L"
                                   HorizontalAlignment="Right"
                                   FontFamily="{StaticResource MonoFont}"
                                   FontSize="12.5"
                                   Foreground="{StaticResource GoldSoftBrush}" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,10" />

                    <Grid>
                        <TextBlock Text="Registration" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding PanicHotkeyStatus}" HorizontalAlignment="Right" FontSize="11.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PanicHotkeyActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="Onno app already ei hotkey use korle registration fail kore — tokhono baki sob feature chalu thake."
                               Style="{StaticResource MutedText}"
                               FontSize="10.5"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ Startup ============ -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Startup" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Text="Dwarpal sign-in er somoy nijei chalu hobe, tai app lock engine PC chalu hote sathe sathe active thakbe."
                               Style="{StaticResource MutedText}"
                               FontSize="11.5"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Start Dwarpal when I sign in" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Windows Task Scheduler · highest privileges"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="AutoStartCheckBox"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Enabled"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsNotBusy}"
                                  IsChecked="{Binding AutoStartEnabled, Mode=OneWay}"
                                  Click="OnAutoStartClick" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ Tamper protection ============ -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Tamper protection" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Text="Dwarpal bondho kore diye protection bypass kora jabe na. Watchdog Task Scheduler e prottek minute check kore, ar process DACL terminate block kore."
                               Style="{StaticResource MutedText}"
                               FontSize="11.5"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,16,0,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Restart Dwarpal if it is closed" Style="{StaticResource SettingLabel}" />
                            <TextBlock Text="Task Scheduler · every 1 minute · highest privileges"
                                       Style="{StaticResource MutedText}"
                                       FontSize="11"
                                       Margin="0,4,0,0" />
                        </StackPanel>

                        <CheckBox x:Name="WatchdogCheckBox"
                                  Style="{StaticResource AppCheckBox}"
                                  Content="Enabled"
                                  HorizontalAlignment="Right"
                                  VerticalAlignment="Center"
                                  IsEnabled="{Binding IsNotBusy}"
                                  IsChecked="{Binding WatchdogEnabled, Mode=OneWay}"
                                  Click="OnWatchdogClick" />
                    </Grid>

                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,14" />

                    <Grid>
                        <TextBlock Text="Process hardening (DACL)" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding HardeningLabel}" HorizontalAlignment="Right" FontSize="11.5">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HardeningActive}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <TextBlock Text="Window close korle tray e chole jay, engine chalu thake. Tray Exit e credential lagbe."
                               Style="{StaticResource MutedText}"
                               FontSize="10.5"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ Account / security ============ -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Security" Style="{StaticResource TitleText}" FontSize="15" />

                    <Grid Margin="0,14,0,0">
                        <TextBlock Text="Unlock credential" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding CredentialLabel}" Style="{StaticResource StatusValue}" />
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,10" />

                    <Grid>
                        <TextBlock Text="Recovery key" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding RecoveryKeyStatus}" Style="{StaticResource StatusValue}" />
                    </Grid>
                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,10" />

                    <Grid>
                        <TextBlock Text="Version" Style="{StaticResource StatusLabel}" />
                        <TextBlock Text="{Binding VersionText}" Style="{StaticResource StatusValue}" />
                    </Grid>

                    <TextBlock Text="Data folder: %ProgramData%\Dwarpal — database ar log ekhanei thake."
                               Style="{StaticResource MutedText}"
                               FontSize="10.5"
                               Margin="0,14,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
