<Window x:Class="Dwarpal.App.Views.CredentialPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Dwarpal.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Confirm identity"
        Width="440" Height="610"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Topmost="True"
        Opacity="0"
        Style="{StaticResource AppWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="4"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragAreaMouseDown">
                <TextBlock Text="CONFIRM IDENTITY"
                           Style="{StaticResource OverlineText}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <Button Style="{StaticResource TitleBarCloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Content="&#xE8BB;"
                        Click="OnCancelClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="30,0,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" VerticalAlignment="Center">
                    <Border Width="60" Height="60" CornerRadius="18"
                            Background="{StaticResource GoldTintBrush}"
                            BorderBrush="{StaticResource GoldBrush}"
                            BorderThickness="1"
                            HorizontalAlignment="Center">
                        <TextBlock Text="&#xE72E;"
                                   FontFamily="{StaticResource IconFont}"
                                   FontSize="24"
                                   Foreground="{StaticResource GoldSoftBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Confirm it's you"
                               Style="{StaticResource TitleText}"
                               FontSize="20"
                               HorizontalAlignment="Center"
                               Margin="0,14,0,0" />

                    <TextBlock Text="{Binding Reason}"
                               Style="{StaticResource MutedText}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"
                               MaxWidth="320" />

                    <controls:PinPad x:Name="PinPadControl"
                                     SubmitText="Confirm"
                                     Margin="0,18,0,0"
                                     Visibility="{Binding IsPin, Converter={StaticResource BoolToVisibility}}"
                                     IsEnabled="{Binding CanAttempt}"
                                     Submitted="OnPinPadSubmitted"
                                     SecretChanged="OnSecretChanged" />

                    <StackPanel Visibility="{Binding IsPassword, Converter={StaticResource BoolToVisibility}}">
                        <PasswordBox x:Name="PasswordBoxInput"
                                     Style="{StaticResource AppPasswordBox}"
                                     Margin="0,20,0,0"
                                     IsEnabled="{Binding CanAttempt}"
                                     KeyDown="OnPasswordKeyDown"
                                     ToolTip="Password" />
                        <Button Content="Confirm"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,10,0,0"
                                IsEnabled="{Binding CanAttempt}"
                                Click="OnPasswordConfirmClick" />
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}"
                               Style="{StaticResource DangerText}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               Margin="0,12,0,0" />

                    <TextBlock Text="{Binding Lockout.Text}"
                               Style="{StaticResource MutedText}"
                               Foreground="{StaticResource GoldSoftBrush}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"
                               Margin="0,6,0,0" />
                </StackPanel>

                <Button Grid.Row="1"
                        Content="Cancel"
                        Style="{StaticResource SecondaryButton}"
                        HorizontalAlignment="Center"
                        Click="OnCancelClick" />
            </Grid>
        </Grid>
    </Border>
</Window>
