<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dwarpal palette: deep navy (night watch) + gold (guard's brass) -->
    <Color x:Key="Navy950">#FF050A13</Color>
    <Color x:Key="Navy900">#FF070E1A</Color>
    <Color x:Key="Navy850">#FF0C1626</Color>
    <Color x:Key="Navy800">#FF101C2E</Color>
    <Color x:Key="Navy700">#FF14213A</Color>
    <Color x:Key="Navy600">#FF1B2C47</Color>
    <Color x:Key="Navy500">#FF22334F</Color>
    <Color x:Key="Ink100">#FFF2F6FC</Color>
    <Color x:Key="Ink300">#FFC2CEDF</Color>
    <Color x:Key="Ink500">#FF8C9BAF</Color>
    <Color x:Key="Gold500">#FFD4AF37</Color>
    <Color x:Key="Gold400">#FFE7C96B</Color>
    <Color x:Key="Gold300">#FFF5E3A6</Color>
    <Color x:Key="Danger">#FFE0525B</Color>
    <Color x:Key="Success">#FF46B98A</Color>

    <!-- Color key gulo ke Brush hisebeo expose kora hocche: WPF resource theke Color,
         Brush property te auto-convert hoy na. -->
    <SolidColorBrush x:Key="Navy950Brush" Color="{StaticResource Navy950}" />
    <SolidColorBrush x:Key="Navy900Brush" Color="{StaticResource Navy900}" />
    <SolidColorBrush x:Key="Navy850Brush" Color="{StaticResource Navy850}" />
    <SolidColorBrush x:Key="Navy800Brush" Color="{StaticResource Navy800}" />
    <SolidColorBrush x:Key="Navy700Brush" Color="{StaticResource Navy700}" />
    <SolidColorBrush x:Key="Navy600Brush" Color="{StaticResource Navy600}" />
    <SolidColorBrush x:Key="Navy500Brush" Color="{StaticResource Navy500}" />
    <SolidColorBrush x:Key="Ink100Brush" Color="{StaticResource Ink100}" />
    <SolidColorBrush x:Key="Ink300Brush" Color="{StaticResource Ink300}" />
    <SolidColorBrush x:Key="Ink500Brush" Color="{StaticResource Ink500}" />
    <SolidColorBrush x:Key="Gold500Brush" Color="{StaticResource Gold500}" />
    <SolidColorBrush x:Key="Gold400Brush" Color="{StaticResource Gold400}" />
    <SolidColorBrush x:Key="Gold300Brush" Color="{StaticResource Gold300}" />

    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource Navy900}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Navy850}" />
    <SolidColorBrush x:Key="SurfaceAltBrush" Color="{StaticResource Navy700}" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="{StaticResource Navy600}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FF0B1524" />
    <SolidColorBrush x:Key="BorderBrush" Color="#FF22334F" />
    <SolidColorBrush x:Key="BorderSoftBrush" Color="#FF182742" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink100}" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="{StaticResource Ink300}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Ink500}" />
    <SolidColorBrush x:Key="GoldBrush" Color="{StaticResource Gold500}" />
    <SolidColorBrush x:Key="GoldSoftBrush" Color="{StaticResource Gold400}" />
    <SolidColorBrush x:Key="GoldPaleBrush" Color="{StaticResource Gold300}" />
    <SolidColorBrush x:Key="GoldTintBrush" Color="#1FD4AF37" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="SuccessBrush" Color="{StaticResource Success}" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#14FFFFFF" />

    <LinearGradientBrush x:Key="GoldGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFE7C96B" Offset="0" />
        <GradientStop Color="#FFD4AF37" Offset="0.55" />
        <GradientStop Color="#FFB8912A" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="BrandPanelBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF101E33" Offset="0" />
        <GradientStop Color="#FF080F1C" Offset="0.65" />
        <GradientStop Color="#FF050A13" Offset="1" />
    </LinearGradientBrush>

    <FontFamily x:Key="AppFont">Segoe UI</FontFamily>
    <FontFamily x:Key="DisplayFont">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>
    <FontFamily x:Key="IconFont">Segoe MDL2 Assets</FontFamily>

</ResourceDictionary>
