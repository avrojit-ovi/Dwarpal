<UserControl x:Class="Dwarpal.App.Controls.PinPad"
             x:Name="PinPadRoot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignWidth="320"
             d:DesignHeight="400">

    <StackPanel>
        <Border Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderSoftBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="10">
            <PasswordBox x:Name="SecretBox"
                         Style="{StaticResource PinDisplayBox}"
                         MaxLength="8" />
        </Border>

        <UniformGrid Columns="3" Margin="0,12,0,0">
            <Button Style="{StaticResource PinKeyButton}" Content="1" Tag="1" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="2" Tag="2" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="3" Tag="3" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="4" Tag="4" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="5" Tag="5" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="6" Tag="6" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="7" Tag="7" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="8" Tag="8" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="9" Tag="9" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}"
                    Content="CLR"
                    FontSize="13"
                    Foreground="{StaticResource MutedBrush}"
                    Click="OnClearClick" />
            <Button Style="{StaticResource PinKeyButton}" Content="0" Tag="0" Click="OnDigitClick" />
            <Button Style="{StaticResource PinKeyButton}"
                    Content="DEL"
                    FontSize="13"
                    Foreground="{StaticResource MutedBrush}"
                    Click="OnBackspaceClick" />
        </UniformGrid>

        <Button Content="{Binding SubmitText, ElementName=PinPadRoot}"
                Style="{StaticResource PrimaryButton}"
                Margin="0,10,0,0"
                Click="OnSubmitClick" />
    </StackPanel>
</UserControl>
