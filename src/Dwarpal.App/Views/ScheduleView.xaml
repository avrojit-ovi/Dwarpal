<UserControl x:Class="Dwarpal.App.Views.ScheduleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignWidth="820">

    <UserControl.Resources>
        <Style x:Key="StepButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="Background" Value="{StaticResource SurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="BorderBrush" Value="{StaticResource GoldBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,0,28,24">
        <StackPanel>
            <StackPanel>
                <TextBlock Text="Schedule" Style="{StaticResource HeroText}" FontSize="24" />
                <TextBlock Text="Protection window — baire thakle protected app open korle lock hobe na."
                           Style="{StaticResource MutedText}"
                           Margin="0,6,0,0" />
            </StackPanel>

            <TextBlock Text="{Binding StatusMessage}" Margin="0,14,0,0" FontSize="11.5">
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource MutedText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsStatusError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <!-- Current state -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{StaticResource MutedBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsScheduleOpen}" Value="True">
                                        <Setter Property="Fill" Value="{StaticResource SuccessBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>

                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateText}"
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="17"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding StateDetail}"
                                   Style="{StaticResource MutedText}"
                                   FontSize="11.5"
                                   Margin="0,4,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Add window -->
            <Border Style="{StaticResource CardBorder}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock Text="Add protection window" Style="{StaticResource TitleText}" FontSize="15" />
                    <TextBlock Text="Ei somoy gulo te protected app lock hobe. Ekadhik window add korte paro — jekono ekta mile gele protection active."
                               Style="{StaticResource MutedText}"
                               FontSize="11.5"
                               Margin="0,6,0,0" />

                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource AppTextBox}"
                                 Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Window name" />
                        <Button Grid.Column="1"
                                Content="Add window"
                                Style="{StaticResource PrimaryButton}"
                                Margin="10,0,0,0"
                                Click="OnAddClick" />
                    </Grid>

                    <TextBlock Text="DAYS" Style="{StaticResource OverlineText}" FontSize="9" Margin="0,16,0,8" />
                    <ItemsControl ItemsSource="{Binding Days}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource AppCheckBox}"
                                          Content="{Binding Label}"
                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                          Margin="0,0,14,8" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="STARTS" Style="{StaticResource OverlineText}" FontSize="9" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#xE738;" Style="{StaticResource StepButton}"
                                        FontFamily="{StaticResource IconFont}" ToolTip="30 min age"
                                        Click="OnStartBackClick" />
                                <TextBlock Text="{Binding StartTime}"
                                           Width="76"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource GoldSoftBrush}" />
                                <Button Content="+" Style="{StaticResource StepButton}" ToolTip="30 min pore"
                                        Click="OnStartForwardClick" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="ENDS" Style="{StaticResource OverlineText}" FontSize="9" Margin="0,0,0,6" />
                            <StackPanel Orientation="Horizontal">
                                <Button Content="&#xE738;" Style="{StaticResource StepButton}"
                                        FontFamily="{StaticResource IconFont}" ToolTip="30 min age"
                                        Click="OnEndBackClick" />
                                <TextBlock Text="{Binding EndTime}"
                                           Width="76"
                                           TextAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="{StaticResource MonoFont}"
                                           FontSize="14"
                                           Foreground="{StaticResource GoldSoftBrush}" />
                                <Button Content="+" Style="{StaticResource StepButton}" ToolTip="30 min pore"
                                        Click="OnEndForwardClick" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Start > end dile window midnight cross korbe (jemon 22:00–02:00)."
                               Style="{StaticResource MutedText}"
                               FontSize="10.5"
                               Margin="0,12,0,0" />
                </StackPanel>
            </Border>

            <!-- Windows list -->
            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasWindows, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="WINDOW" Style="{StaticResource OverlineText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" />
                        <TextBlock Text="STATUS" Style="{StaticResource OverlineText}" FontSize="9.5" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Right" Margin="0,0,76,0" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Windows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Grid Margin="0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Summary}"
                                                       Style="{StaticResource MutedText}"
                                                       FontFamily="{StaticResource MonoFont}"
                                                       FontSize="10.5"
                                                       Margin="0,2,0,0" />
                                        </StackPanel>

                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource AppCheckBox}"
                                                  Content="Enabled"
                                                  IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  VerticalAlignment="Center"
                                                  Margin="12,0,12,0"
                                                  Click="OnToggleClick" />

                                        <Button Grid.Column="2"
                                                Content="Delete"
                                                Style="{StaticResource LinkButton}"
                                                Foreground="{StaticResource MutedBrush}"
                                                VerticalAlignment="Center"
                                                Click="OnDeleteClick" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorder}"
                    Margin="0,16,0,0"
                    Visibility="{Binding HasNoWindows, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" Margin="0,8">
                    <TextBlock Text="No windows yet" Style="{StaticResource TitleText}" HorizontalAlignment="Center" />
                    <TextBlock Text="Window add na korle protection 24/7 active thake — etai default."
                               Style="{StaticResource MutedText}"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
