<Window x:Class="Dwarpal.App.Views.SetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dwarpal Setup"
        WindowStartupLocation="CenterScreen"
        Width="860" Height="620"
        Opacity="0"
        Style="{StaticResource AppWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="4"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Brand panel ============ -->
            <Border Grid.Column="0"
                    Background="{StaticResource BrandPanelBrush}"
                    CornerRadius="14,0,0,14"
                    MouseLeftButtonDown="OnDragAreaMouseDown">
                <Grid Margin="30,34">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="44" Height="44"
                                CornerRadius="12"
                                Background="{StaticResource Navy950Brush}"
                                BorderBrush="{StaticResource BorderSoftBrush}"
                                BorderThickness="1"
                                Padding="2">
                            <Image Source="pack://application:,,,/Dwarpal;component/Assets/Branding/dwarpal-mark-512.png"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality" />
                        </Border>
                        <StackPanel VerticalAlignment="Center" Margin="12,0,0,0">
                            <TextBlock Text="DWARPAL" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="WINDOWS APP LOCKER" Style="{StaticResource MutedText}" FontSize="8.5" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Row="1" VerticalAlignment="Center">
                        <TextBlock Text="Your apps."
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="31"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="Under guard."
                                   FontFamily="{StaticResource DisplayFont}"
                                   FontSize="31"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource GoldSoftBrush}" />
                        <TextBlock Style="{StaticResource BodyText}"
                                   Margin="0,18,0,0"
                                   MaxWidth="230"
                                   HorizontalAlignment="Left"
                                   Text="PIN diye protected app unlock koro. Bhul koto bar holo, ke unlock korlo - sob activity log e thakbe." />
                    </StackPanel>

                    <StackPanel Grid.Row="2">
                        <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,0,0,14" />
                        <TextBlock Text="SETUP · v1.0" Style="{StaticResource MutedText}" FontSize="10.5" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ Wizard content ============ -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="46" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragAreaMouseDown">
                    <TextBlock Text="SECURE SETUP"
                               Style="{StaticResource OverlineText}"
                               FontSize="10"
                               VerticalAlignment="Center"
                               Margin="34,0,0,0" />
                    <Button Style="{StaticResource TitleBarCloseButton}"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Margin="0,0,12,0"
                            Content="&#xE8BB;"
                            ToolTip="Close setup"
                            Click="OnCloseClick" />
                </Grid>

                <Grid Grid.Row="1" Margin="34,6,34,26">

                    <!-- Step 1: welcome -->
                    <Grid Visibility="{Binding IsWelcomeStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center" MaxWidth="420" HorizontalAlignment="Left">
                            <TextBlock Text="WELCOME" Style="{StaticResource OverlineText}" />
                            <TextBlock Style="{StaticResource HeroText}" Margin="0,12,0,0" Text="One code. Every protected app." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,16,0,0"
                                       Text="Dwarpal Windows er jonno ekta app locker. Je app gulo protect korbe, segulo khulte gele prothome Dwarpal er lock screen ashbe." />

                            <StackPanel Margin="0,26,0,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,0" Text="PIN othoba letter+number password - apnar choice." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,0" Text="Ekbar-i dekhano recovery key - password bhule gele jibon raksha." />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Width="6" Height="6" Fill="{StaticResource GoldBrush}" VerticalAlignment="Center" />
                                    <TextBlock Style="{StaticResource BodyText}" Margin="12,0,0,0" Text="Sob unlock attempt activity log e - date, time ar app name shoho." />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Get started"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="140"
                                    Command="{Binding StartSetupCommand}" />
                        </StackPanel>
                    </Grid>

                    <!-- Step 2: credential -->
                    <Grid Visibility="{Binding IsCredentialStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="430" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="STEP 1 OF 2" Style="{StaticResource OverlineText}" />
                                <TextBlock Style="{StaticResource HeroText}" FontSize="26" Margin="0,10,0,0" Text="Choose your unlock code" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                                           Text="Ei code diye Dwarpal ar protected app gulo unlock korbe. Ei code kokhono plain text e save hoy na." />

                                <Grid Margin="0,20,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <RadioButton Grid.Column="0"
                                                 Style="{StaticResource MethodRadio}"
                                                 GroupName="CredentialKind"
                                                 IsChecked="True"
                                                 Margin="0,0,6,0"
                                                 Checked="OnPinChecked">
                                        <StackPanel>
                                            <TextBlock Text="PIN" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="4–8 digits · fastest" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </RadioButton>

                                    <RadioButton Grid.Column="1"
                                                 Style="{StaticResource MethodRadio}"
                                                 GroupName="CredentialKind"
                                                 Margin="6,0,0,0"
                                                 Checked="OnPasswordChecked">
                                        <StackPanel>
                                            <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" />
                                            <TextBlock Text="8+ chars · letter + number" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                        </StackPanel>
                                    </RadioButton>
                                </Grid>

                                <TextBlock Text="{Binding CredentialHint}" Style="{StaticResource MutedText}" Margin="0,16,0,0" />

                                <PasswordBox x:Name="SecretBox"
                                             Style="{StaticResource AppPasswordBox}"
                                             Margin="0,8,0,0"
                                             MaxLength="64"
                                             KeyDown="OnSecretKeyDown" />

                                <PasswordBox x:Name="ConfirmBox"
                                             Style="{StaticResource AppPasswordBox}"
                                             Margin="0,10,0,0"
                                             MaxLength="64"
                                             KeyDown="OnSecretKeyDown"
                                             ToolTip="Confirm PIN/password" />

                                <TextBlock Text="{Binding ErrorMessage}"
                                           Style="{StaticResource DangerText}"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Back"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0"
                                    Command="{Binding BackCommand}" />
                            <Button Content="Continue"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="140"
                                    IsEnabled="{Binding IsNotBusy}"
                                    Click="OnCredentialContinueClick" />
                        </StackPanel>
                    </Grid>

                    <!-- Step 3: recovery key -->
                    <Grid Visibility="{Binding IsRecoveryStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="450" HorizontalAlignment="Left" VerticalAlignment="Center">
                                <TextBlock Text="STEP 2 OF 2" Style="{StaticResource OverlineText}" />
                                <TextBlock Style="{StaticResource HeroText}" FontSize="26" Margin="0,10,0,0" Text="Save your recovery key" />
                                <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                                           Text="Ei key ta ekbar-i dekhabe. Print koro ba password manager e rakho. PIN bhule gele ei key diye notun credential set korte parbe." />

                                <Border Style="{StaticResource CardBorder}" Margin="0,20,0,0" Padding="16">
                                    <StackPanel>
                                        <TextBox Text="{Binding RecoveryKey, Mode=OneWay}"
                                                 Style="{StaticResource AppTextBox}"
                                                 IsReadOnly="True"
                                                 FontFamily="{StaticResource MonoFont}"
                                                 FontSize="16"
                                                 TextAlignment="Center"
                                                 Padding="10,15"
                                                 Foreground="{StaticResource GoldSoftBrush}"
                                                 Background="{StaticResource WindowBackgroundBrush}" />

                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                            <Button Content="Copy key"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="14,7"
                                                    FontSize="12.5"
                                                    Margin="0,0,8,0"
                                                    Click="OnCopyRecoveryKeyClick" />
                                            <Button Content="Print"
                                                    Style="{StaticResource SecondaryButton}"
                                                    Padding="14,7"
                                                    FontSize="12.5"
                                                    Click="OnPrintRecoveryKeyClick" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock x:Name="CopyStatusText"
                                           Style="{StaticResource MutedText}"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Margin="0,6,0,0"
                                           Text="" />

                                <CheckBox Style="{StaticResource AppCheckBox}"
                                          Margin="0,16,0,0"
                                          IsChecked="{Binding RecoveryAcknowledged}"
                                          Content="Recovery key ta save korechi. Ami bujhi je key harale recovery possible na." />

                                <TextBlock Text="{Binding ErrorMessage}"
                                           Style="{StaticResource DangerText}"
                                           Margin="0,10,0,0" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Back"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="0,0,10,0"
                                    Command="{Binding BackCommand}" />
                            <Button Content="Continue"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="140"
                                    IsEnabled="{Binding RecoveryAcknowledged}"
                                    Click="OnRecoveryContinueClick" />
                        </StackPanel>
                    </Grid>

                    <!-- Step 4: done -->
                    <Grid Visibility="{Binding IsDoneStep, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" VerticalAlignment="Center" MaxWidth="430" HorizontalAlignment="Left">
                            <Border Width="64" Height="64" CornerRadius="20" Background="{StaticResource GoldGradientBrush}" HorizontalAlignment="Left">
                                <Viewbox Width="30" Height="30">
                                    <Path Data="M1,11 L8,18 L22,3"
                                          Stroke="{StaticResource Navy950Brush}"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Border>

                            <TextBlock Style="{StaticResource HeroText}" FontSize="28" Margin="0,20,0,0" Text="Account ready." />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                                       Text="Credential ar recovery key set hoye geche. App locking engine (process watch, lock screen, tamper protection) next phase e add hobe." />

                            <Border Style="{StaticResource CardBorder}" Margin="0,22,0,0">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="Credential" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="{Binding KindLabel}" HorizontalAlignment="Right" FontSize="12.5" />
                                    </Grid>
                                    <Rectangle Height="1" Fill="{StaticResource HairlineBrush}" Margin="0,10" />
                                    <Grid>
                                        <TextBlock Text="Recovery key" Style="{StaticResource MutedText}" />
                                        <TextBlock Text="Saved" HorizontalAlignment="Right" FontSize="12.5" Foreground="{StaticResource SuccessBrush}" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Open dashboard"
                                    Style="{StaticResource PrimaryButton}"
                                    MinWidth="160"
                                    Click="OnFinishClick" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
