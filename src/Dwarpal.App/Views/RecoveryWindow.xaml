<Window x:Class="Dwarpal.App.Views.RecoveryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Dwarpal Recovery"
        WindowStartupLocation="CenterScreen"
        Width="560" Height="680"
        ShowInTaskbar="False"
        Opacity="0"
        Style="{StaticResource AppWindow}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="4"
                      CornerRadius="14"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border CornerRadius="14"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="OnDragAreaMouseDown">
                <TextBlock Text="RECOVERY"
                           Style="{StaticResource OverlineText}"
                           FontSize="10"
                           VerticalAlignment="Center"
                           Margin="24,0,0,0" />
                <Button Style="{StaticResource TitleBarCloseButton}"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Margin="0,0,10,0"
                        Content="&#xE8BB;"
                        Click="OnCloseClick" />
            </Grid>

            <Grid Grid.Row="1" Margin="34,0,34,24">

                <!-- ============ Reset form ============ -->
                <Grid Visibility="{Binding IsForm, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Reset your credential" Style="{StaticResource HeroText}" FontSize="24" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                                       Text="Setup er somoy dekhano recovery key ta dao. Tarpor notun PIN ba password set koro." />

                            <TextBlock Text="Recovery key" Style="{StaticResource MutedText}" Margin="0,20,0,6" />
                            <TextBox x:Name="RecoveryKeyBox"
                                     Style="{StaticResource AppTextBox}"
                                     FontFamily="{StaticResource MonoFont}"
                                     FontSize="14"
                                     MaxLength="48"
                                     ToolTip="XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX-XXXX" />

                            <TextBlock Text="Notun credential" Style="{StaticResource MutedText}" Margin="0,18,0,8" />

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <RadioButton Grid.Column="0"
                                             Style="{StaticResource MethodRadio}"
                                             GroupName="RecoveryKind"
                                             IsChecked="True"
                                             Margin="0,0,6,0"
                                             Checked="OnPinChecked">
                                    <StackPanel>
                                        <TextBlock Text="PIN" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="4–8 digits" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>

                                <RadioButton Grid.Column="1"
                                             Style="{StaticResource MethodRadio}"
                                             GroupName="RecoveryKind"
                                             Margin="6,0,0,0"
                                             Checked="OnPasswordChecked">
                                    <StackPanel>
                                        <TextBlock Text="Password" FontSize="14" FontWeight="SemiBold" />
                                        <TextBlock Text="8+ chars · letter + number" Style="{StaticResource MutedText}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </Grid>

                            <TextBlock Text="{Binding CredentialHint}" Style="{StaticResource MutedText}" Margin="0,12,0,6" />

                            <PasswordBox x:Name="NewSecretBox" Style="{StaticResource AppPasswordBox}" MaxLength="64" />
                            <PasswordBox x:Name="ConfirmSecretBox" Style="{StaticResource AppPasswordBox}" Margin="0,10,0,0" MaxLength="64"
                                         ToolTip="Confirm new PIN/password" />

                            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource DangerText}" Margin="0,10,0,0" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Cancel"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,10,0"
                                Click="OnCancelClick" />
                        <Button Content="Reset credential"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="160"
                                IsEnabled="{Binding IsNotBusy}"
                                Click="OnResetClick" />
                    </StackPanel>
                </Grid>

                <!-- ============ Result ============ -->
                <Grid Visibility="{Binding IsResult, Converter={StaticResource BoolToVisibility}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                        <StackPanel VerticalAlignment="Center">
                            <Border Width="56" Height="56" CornerRadius="18" Background="{StaticResource GoldTintBrush}"
                                    BorderBrush="{StaticResource GoldBrush}" BorderThickness="1" HorizontalAlignment="Left">
                                <Viewbox Width="26" Height="26">
                                    <Path Data="M1,11 L8,18 L22,3"
                                          Stroke="{StaticResource GoldSoftBrush}"
                                          StrokeThickness="3"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          StrokeLineJoin="Round" />
                                </Viewbox>
                            </Border>

                            <TextBlock Text="Credential reset" Style="{StaticResource HeroText}" FontSize="24" Margin="0,16,0,0" />
                            <TextBlock Style="{StaticResource BodyText}" Margin="0,10,0,0"
                                       Text="Notun recovery key ta save koro. Purano key ta ekhon ar kaj korbe na." />

                            <Border Style="{StaticResource CardBorder}" Margin="0,18,0,0" Padding="16">
                                <StackPanel>
                                    <TextBox Text="{Binding NewRecoveryKey, Mode=OneWay}"
                                             Style="{StaticResource AppTextBox}"
                                             IsReadOnly="True"
                                             FontFamily="{StaticResource MonoFont}"
                                             FontSize="15"
                                             TextAlignment="Center"
                                             Padding="10,14"
                                             Foreground="{StaticResource GoldSoftBrush}"
                                             Background="{StaticResource WindowBackgroundBrush}" />

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                        <Button Content="Copy key"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="14,7"
                                                FontSize="12.5"
                                                Margin="0,0,8,0"
                                                Click="OnCopyNewKeyClick" />
                                        <Button Content="Print"
                                                Style="{StaticResource SecondaryButton}"
                                                Padding="14,7"
                                                FontSize="12.5"
                                                Click="OnPrintNewKeyClick" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock x:Name="ResultStatusText"
                                       Style="{StaticResource MutedText}"
                                       Foreground="{StaticResource SuccessBrush}"
                                       Margin="0,6,0,0"
                                       Text="" />
                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                        <Button Content="Done"
                                Style="{StaticResource PrimaryButton}"
                                MinWidth="130"
                                Click="OnDoneClick" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Border>
</Window>
